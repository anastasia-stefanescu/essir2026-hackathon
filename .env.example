# Copy to .env and edit. The app reads this file at startup (app/config.py).
# docker-compose.yml overrides the *_URL values for in-container networking.

# --- LLM provider -----------------------------------------------------------
# Which backend answers questions and produces embeddings.
#   ollama   | LM Studio  | litellm (hosted APIs — OpenAI, Anthropic, Gemini, ...)
LLM_PROVIDER=ollama

# The generation model and the embedding model, named as your provider expects.
#   ollama examples:   CHAT_MODEL=llama3.1        EMBEDDING_MODEL=nomic-embed-text
#   LM Studio:         whatever you have loaded in the LM Studio server
#   litellm:           CHAT_MODEL=gpt-4o-mini     EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# --- Provider endpoints -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# litellm: leave blank to use the provider's default endpoint. Set an API key for
# hosted providers (or export the provider's own env var, e.g. OPENAI_API_KEY).
LITELLM_API_BASE=
LITELLM_API_KEY=

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fourth_turn

# --- Retrieval knobs (tune these) -------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Misc -------------------------------------------------------------------
DATA_DIR=data
REQUEST_TIMEOUT=120
